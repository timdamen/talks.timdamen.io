---
// ConferenceInfoCard.astro
export interface Props {
  conferenceLogo: string;
  conferenceVenue: string;
  conferenceLocation: string;
  conferenceName: string;
  conferenceURL: string;
  conferenceLogoBackground: string;
  conferenceDate: string | Date;
  logoAlt?: string;
}

const {
  conferenceLogo,
  conferenceVenue,
  conferenceLocation,
  conferenceName,
  conferenceURL,
  conferenceDate,
  conferenceLogoBackground,
  logoAlt,
} = Astro.props;

// get only year from conferenceDate
const conferenceYear = new Date(conferenceDate).getFullYear();

// Generate alt text for logo if not provided
const logoAltText = logoAlt || `${conferenceName} conference logo`;
---

<div>
  <div
    class="flex flex-col items-center gap-3 text-center sm:flex-row sm:text-left"
  >
    <div class="flex-shrink-0">
      <img
        src={conferenceLogo}
        alt={logoAltText}
        class="h-auto max-h-28 w-full max-w-48 rounded-xl border-2 border-slate-200 object-contain p-2 dark:border-slate-600 "
        class:list={[
          {
            "bg-[#212737]! dark:bg-transparent!":
              conferenceLogoBackground === "dark",
          },
          "bg-white",
        ]}
        loading="lazy"
      />
    </div>
    <div class="min-w-0 flex-1">
      <a
        href={conferenceURL}
        class="inline-flex items-center gap-4 rounded-md text-xl leading-tight font-bold text-slate-800 transition-colors duration-200  focus:ring-3 hover:text-accent focus:ring-offset-2 focus:outline-none dark:text-white "
        target="_blank"
        rel="noopener noreferrer"
      >
        {conferenceName}
        {conferenceYear}
      </a>
      <p class="m-0">{conferenceVenue}, {conferenceLocation}</p>
    </div>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Additional responsive styles for very small devices */
  @media (max-width: 480px) {
    .max-w-2xl {
      margin-left: 1rem;
      margin-right: 1rem;
    }

    .p-8 {
      padding: 1.5rem;
    }

    .gap-6 > * {
      padding: 1rem;
      background: white;
      border-radius: 0.5rem;
      border: 1px solid rgb(226 232 240);
    }

    .dark .gap-6 > * {
      background: rgb(51 65 85);
      border-color: rgb(71 85 105);
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .transition-shadow,
    .transition-colors,
    .transition-all {
      transition: none;
    }

    .hover\\:translate-x-0\\.5:hover {
      transform: none;
    }

    .hover\\:-translate-y-0\\.5:hover {
      transform: none;
    }
  }
</style>
