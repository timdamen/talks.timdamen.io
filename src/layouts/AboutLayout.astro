---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import Socials from "@/components/Socials.astro";
import IconRss from "@/assets/icons/IconRss.svg";
import { SOCIALS } from "@/constants";
import Hr from "@/components/Hr.astro";
import { TabItem, Code } from "@astrojs/starlight/components";
import Tabs from "@/components/Tabs.astro";
import myImage from "../assets/images/NDC-oslo-1.webp";
import stageImage from "../assets/images/stage2.webp";
import Image from "astro/components/Image.astro";
import Logos from "@/components/Logos.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const shortBioHtml = `<p>
  Driven by the mission to make people's lives easier, Tim Damen actively
  advocates for and builds a web that serves everyone equally. Tim is a
  frontend developer, web accessibility specialist, and co-founder of
  <a target="_blank" rel="noopener" href="https://focusring.io">Focusring</a>,
  a digital accessibility consultancy, from Amsterdam, the Netherlands 🇳🇱.
  With over a decade of experience at major financial institutions and
  government organizations, Tim speaks at conferences and meetups around the
  world, contributes to open source projects like
  <a target="_blank" rel="noopener" href="https://github.com/nuxt/a11y">nuxt/a11y</a>,
  and hosts
  "<a target="_blank" rel="noopener" href="https://focusring.io/podcast-focustrap">focustrap</a>,"
  a podcast about digital accessibility.
</p>`;

const longBioHtml = `<p>
  Tim Damen is a frontend developer, web accessibility specialist, and
  co-founder of
  <a target="_blank" rel="noopener" href="https://focusring.io">Focusring</a>,
  a digital accessibility consultancy, based in Amsterdam, the Netherlands 🇳🇱.
  Driven by the mission to make people's lives easier, he actively advocates
  for and builds a web that serves everyone equally.
</p>

<p>
  With over a decade of experience—working with major financial institutions
  and government organizations—Tim specializes in JavaScript, HTML, CSS,
  developer experience (DX), web standards, accessibility, and developing
  robust web applications. Through Focusring, he helps organizations prepare
  for the European Accessibility Act and build accessibility into their
  engineering culture. He contributes to open source projects such as
  <a target="_blank" rel="noopener" href="https://github.com/nuxt/a11y">nuxt/a11y</a>,
  the official Nuxt accessibility module, and
  <a target="_blank" rel="noopener" href="https://wcagify.com">WCAGify</a>.
</p>

<p>
  A recognized voice in the web development community, Tim speaks at
  conferences and meetups around the world—twelve in 2025 alone—sharing his
  insights on building accessible, user-centered web solutions. He also hosts
  "<a target="_blank" rel="noopener" href="https://focusring.io/podcast-focustrap">focustrap</a>,"
  a podcast dedicated to digital accessibility, where he explores the latest
  trends, challenges, and best practices in making the web more inclusive.
</p>`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: SITE.author,
    url: SITE.profile,
    image: new URL("/assets/stage2.webp", SITE.website).href,
    jobTitle: "Frontend Developer & Web Accessibility Specialist",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Amsterdam",
      addressCountry: "NL",
    },
    sameAs: [
      SITE.website,
      ...SOCIALS.map(social => social.href).filter(href =>
        href.startsWith("http")
      ),
    ],
  },
};
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
  structuredData={structuredData}
>
  <Header />
  <Breadcrumb />
  <main id="main-content">
    <section id="hero" class="pb-6">
      <h1 class="mb-4 inline-block text-4xl font-bold sm:mb-8 sm:text-5xl">
        Tim Damen
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <div
        class="mt-4 flex flex-col items-center gap-6 sm:flex-row sm:items-start"
      >
        <Image
          width={300}
          height={225}
          loading="eager"
          fetchpriority="high"
          src={stageImage}
          alt="Tim Damen speaking on stage with microphone attached to his ear"
          class="w-full max-w-xs rounded-lg shadow-lg sm:w-72 sm:max-w-none"
        />
        <div>
          <p class="max-w-2xl">
            Tim Damen is a frontend developer, web accessibility specialist,
            and co-founder of <a
              target="_blank"
              rel="noopener"
              href="https://focusring.io"
              class="underline decoration-dashed underline-offset-4 hover:text-accent"
              >Focusring</a
            >, a digital accessibility consultancy, from Amsterdam, the
            Netherlands 🇳🇱. He is passionate about HTML, CSS, JavaScript, DX,
            web standards, accessibility, and developing robust web apps. Tim
            has over a decade of experience in the field and speaks at
            conferences and meetups around the world. He also hosts a podcast
            about digital accessibility called <a
              target="_blank"
              rel="noopener"
              href="https://focusring.io/podcast-focustrap"
              class="underline decoration-dashed underline-offset-4 hover:text-accent"
              >focustrap</a
            >.
          </p>

          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  Social Links:
                </div>
                <Socials centered />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <Hr />

    <section class="pt-6 pb-6">
      <h2 class="mb-6 text-3xl font-semibold tracking-wide">Speakers info</h2>
      <h3 class="mb-3 text-2xl font-semibold tracking-wide">Short biography</h3>
      <Tabs>
        <TabItem label="Text">
          <p>
            Driven by the mission to make people's lives easier, Tim Damen
            actively advocates for and builds a web that serves everyone
            equally. Tim is a frontend developer, web accessibility specialist,
            and co-founder of Focusring, a digital accessibility consultancy,
            from Amsterdam, the Netherlands 🇳🇱. With over a decade of
            experience at major financial institutions and government
            organizations, Tim speaks at conferences and meetups around the
            world, contributes to open source projects like nuxt/a11y, and
            hosts "focustrap," a podcast about digital accessibility.
          </p>
        </TabItem>
        <TabItem label="HTML">
          <Code lang="html" code={shortBioHtml} />
        </TabItem>
        <TabItem label="Markdown"
          ><p>
            Driven by the mission to make people's lives easier, Tim Damen
            actively advocates for and builds a web that serves everyone
            equally. Tim is a frontend developer, web accessibility specialist,
            and co-founder of [Focusring](https://focusring.io), a digital
            accessibility consultancy, from Amsterdam, the Netherlands 🇳🇱. With
            over a decade of experience at major financial institutions and
            government organizations, Tim speaks at conferences and meetups
            around the world, contributes to open source projects like
            [nuxt/a11y](https://github.com/nuxt/a11y), and hosts
            "[focustrap](https://focusring.io/podcast-focustrap)," a podcast
            about digital accessibility.
          </p></TabItem
        >
      </Tabs>

      <h3 class="mt-8 mb-3 text-2xl font-semibold tracking-wide">
        Long biography
      </h3>
      <Tabs>
        <TabItem label="Text">
          <p>
            Tim Damen is a frontend developer, web accessibility specialist, and
            co-founder of Focusring, a digital accessibility consultancy, based
            in Amsterdam, the Netherlands 🇳🇱. Driven by the mission to make
            people's lives easier, he actively advocates for and builds a web
            that serves everyone equally.
          </p><br />
          <p>
            With over a decade of experience—working with major financial
            institutions and government organizations—Tim specializes in
            JavaScript, HTML, CSS, developer experience (DX), web standards,
            accessibility, and developing robust web applications. Through
            Focusring, he helps organizations prepare for the European
            Accessibility Act and build accessibility into their engineering
            culture. He contributes to open source projects such as nuxt/a11y,
            the official Nuxt accessibility module, and WCAGify.
          </p><br />
          <p>
            A recognized voice in the web development community, Tim speaks at
            conferences and meetups around the world—twelve in 2025
            alone—sharing his insights on building accessible, user-centered web
            solutions. He also hosts "focustrap," a podcast dedicated to digital
            accessibility, where he explores the latest trends, challenges, and
            best practices in making the web more inclusive.
          </p>
        </TabItem>
        <TabItem label="HTML">
          <Code lang="html" code={longBioHtml} />
        </TabItem>
        <TabItem label="Markdown">
          <p>
            Tim Damen is a frontend developer, web accessibility specialist, and
            co-founder of [Focusring](https://focusring.io), a digital
            accessibility consultancy, based in Amsterdam, the Netherlands 🇳🇱.
            Driven by the mission to make people's lives easier, he actively
            advocates for and builds a web that serves everyone equally.
            <br /><br />
            With over a decade of experience—working with major financial institutions
            and government organizations—Tim specializes in JavaScript, HTML, CSS,
            developer experience (DX), web standards, accessibility, and developing
            robust web applications. Through Focusring, he helps organizations prepare
            for the European Accessibility Act and build accessibility into their
            engineering culture. He contributes to open source projects such as
            [nuxt/a11y](https://github.com/nuxt/a11y), the official Nuxt accessibility
            module, and [WCAGify](https://wcagify.com).
            <br /><br />
            A recognized voice in the web development community, Tim speaks at conferences
            and meetups around the world—twelve in 2025 alone—sharing his insights
            on building accessible, user-centered web solutions. He also hosts "[focustrap](https://focusring.io/podcast-focustrap),"
            a podcast dedicated to digital accessibility, where he explores the latest
            trends, challenges, and best practices in making the web more inclusive.
          </p>
        </TabItem>
      </Tabs>
    </section>

    <Hr />

    <section class="pt-6 pb-6 text-center">
      <h2 class="mb-2 text-3xl font-semibold tracking-wide">Photos of Tim</h2>
      <p class="mb-6">
        Feel free to use these photos for any event-related materials. Click on
        the images to open them in a new tab for high-resolution downloads.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        <a
          href="/assets/stage1.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 1 in new tab"
        >
          <Image
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            src="/assets/stage1.webp"
            alt="Tim Damen speaking on stage with microphone attached to his ear"
            class="rounded-lg shadow-lg"
          />
        </a>

        <a
          href="/assets/stage2.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 2 in new tab"
        >
          <Image
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            src="/assets/stage2.webp"
            alt="Tim Damen speaking on stage with microphone attached to his ear"
            class="rounded-lg shadow-lg"
          />
        </a>

        <a
          href="/assets/speak.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 3 in new tab"
        >
          <Image
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            src="/assets/speak.webp"
            alt="Tim Damen speaking on stage with microphone attached to his ear"
            class="rounded-lg shadow-lg"
          />
        </a>
        <a
          href="/assets/Tim-2.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 4 in new tab"
        >
          <Image
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            src="/assets/Tim-2.webp"
            alt="Tim Damen speaking on stage with microphone attached to his ear"
            class="rounded-lg shadow-lg"
          />
        </a>
        <a
          href="/assets/Tim-1.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 5 in new tab"
        >
          <Image
            width={300}
            height={300}
            loading="lazy"
            decoding="async"
            src="/assets/Tim-1.webp"
            alt="Tim Damen speaking on stage with microphone attached to his ear"
            class="rounded-lg shadow-lg"
          />
        </a>
        <a
          href="/assets/NDC-oslo-1.webp"
          target="_blank"
          rel="noopener"
          aria-label="open image 5 in new tab"
        >
          <Image
            src={myImage}
            alt="Tim Damen speaking on stage at NDC Oslo"
            class="rounded-lg shadow-lg"
          />
        </a>
      </div>

      <!-- <section id="about" class="app-prose mb-28 max-w-6xl prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section> -->
    </section>

    <section class="mt-8 mb-8">
      <h2 class="pb-6 text-3xl font-semibold tracking-wide">
        Events I've been a part of
      </h2>
      <Logos />
    </section>
  </main>
  <Footer />
</Layout>
