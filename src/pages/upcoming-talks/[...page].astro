---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getUpcomingPresentations from "@/utils/getUpcomingPresentations";
import { SITE } from "@/config";
import getMapMarkers from "@/utils/getMapMarkers";
import MapLibre from "@/components/MapLibre.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const presentations = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getUpcomingPresentations(presentations), {
    pageSize: SITE.postPerPage,
  });
}) satisfies GetStaticPaths;

const presentations = await getCollection("blog", ({ data }) => !data.draft);
const upcomingPresentations = getUpcomingPresentations(presentations);
const markers = getMapMarkers(upcomingPresentations);

const { page } = Astro.props;
---

<Layout
  title={`Upcoming talks | ${SITE.title}`}
  description="See where Tim Damen is speaking next: upcoming conference talks with dates, locations, and a map."
>
  <Header />
  <main id="main-content" data-layout="index">
    <Breadcrumb />
    <section id="hero" class="pb-6">
      <h1 class="mt-0 mb-4 inline-block text-4xl font-bold sm:mb-8 sm:text-5xl">
        Upcoming talks
        {
          upcomingPresentations.length > 0 && (
            <span class="-mt-8 -ml-1 flex inline-flex size-5 items-center justify-center rounded-full bg-red-600 py-0.5 align-middle text-base font-bold font-medium text-background dark:bg-red-300">
              {upcomingPresentations.length}
            </span>
          )
        }
      </h1>
      <ul>
        {page.data.map(data => <Card {...data} />)}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="pb-6 text-3xl font-semibold tracking-wide">
        Location upcoming talks
      </h2>
    </section>

    <MapLibre markers={markers} label="Map of upcoming talk locations" />
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
