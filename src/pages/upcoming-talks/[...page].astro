---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPresentations from "@/utils/getSortedPresentations";
import getUpcomingPresentations from "@/utils/getUpcomingPresentations";
import { SITE } from "@/config";
import MapLibre from "@/components/MapLibre.astro";
import CardImage from "@/components/CardImage.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const presentations = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getUpcomingPresentations(presentations), {
    pageSize: SITE.postPerPage,
  });
}) satisfies GetStaticPaths;

const presentations = await getCollection("blog", ({ data }) => !data.draft);
const presentations2 = await getCollection("blog", ({ data }) => !data.draft);
const upcomingPresentations = getUpcomingPresentations(presentations);
const sortedPresentations2 = getSortedPresentations(presentations2);

// get array of all conferences with lat, long, and popupContent from recentPresentations
const conferences = upcomingPresentations
  .map(({ data }) => {
    if (data.conferenceLat && data.conferenceLong) {
      return {
        latitude: data.conferenceLat,
        longitude: data.conferenceLong,
        popupContent: `${data.title} @ ${data.conference} (${data.conferenceLocation})`,
      };
    }
    return null;
  })
  .filter(Boolean);

const { page } = Astro.props;
---

<Layout title={`Upcoming talks | ${SITE.title}`}>
  <Header />
  <main id="main-content" data-layout="index">
<Breadcrumb />
    <section id="hero" class="pb-6">
      
      <h1 class="mb-4 mt-0 inline-block text-4xl font-bold sm:mb-8 sm:text-5xl">
        Upcoming talks
        {
          upcomingPresentations.length > 0 && (
            <span class="-mt-8 -ml-1 flex inline-flex size-5 items-center justify-center rounded-full bg-red-600 py-0.5 align-middle text-base font-bold font-medium text-background dark:bg-red-300">
              {upcomingPresentations.length}
            </span>
          )
        }
      </h1>
      <ul>
        {page.data.map(data => <Card {...data} />)}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="pb-6 text-3xl font-semibold tracking-wide">
        Location upcoming talks
      </h2>
    </section>

    <MapLibre
      container="maplibremap"
      latitude="52.377956"
      longitude="4.897070"
      zoom="2"
      interactive="true"
      conferences={conferences}
      mapstyle="https://demotiles.maplibre.org/style.json"
      containerstyle="width:100vw; height: 500px"
    />
  </main>

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
